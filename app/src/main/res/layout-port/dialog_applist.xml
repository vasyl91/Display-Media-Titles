<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_gravity="center" >

    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_custom"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingBottom="15dp"
        app:layout_constraintWidth_percent="0.8" 
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" 
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" >

        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.0545"
            android:layout_marginTop="10dp" >

            <TextView
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"     
                android:includeFontPadding="false"
                android:padding="0dp" />

            <ImageView
                android:id="@+id/current_app_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.0545"
                app:layout_constraintHeight_percent="0.0545"
                android:layout_marginLeft="20dp"  />

            <TextView
                android:textColor="@android:color/white"
                android:id="@+id/current_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"    
                android:includeFontPadding="false"
                android:padding="0dp" />
        </LinearLayout>

        <TextView
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_list_dialog"    
            android:includeFontPadding="false"
            android:padding="0dp" />

        <GridView
            android:gravity="center"
            android:id="@+id/gridview"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="25dp"
            android:horizontalSpacing="10dp"
            android:verticalSpacing="20dp"
            android:numColumns="2" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>