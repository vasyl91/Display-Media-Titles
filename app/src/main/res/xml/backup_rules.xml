<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and older (android:fullBackupContent). Android 12+ uses
    data_extraction_rules.xml instead (this app targets API 31+). Same content: settings, excluded
    apps and imported fonts only.
-->
<full-backup-content>
    <include domain="sharedpref" path="savedPrefs.xml" />
    <include domain="sharedpref" path="ExcludeAppsPrefs.xml" />
    <include domain="file" path="fonts/" />
</full-backup-content>
