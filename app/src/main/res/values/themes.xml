<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.
         Light instead of DayNight: all layouts use fixed light backgrounds (#F8EECF, the white
         color picker panel), so the dark variant only made check boxes, input hints and the "#"
         label of the color picker (almost) invisible. In light mode nothing changes, because
         DayNight is Light there. -->
    <style name="Base.Theme.DisplayMediaTitles" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primaryDark</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.DisplayMediaTitles" parent="Base.Theme.DisplayMediaTitles" />

    <style name="ExcludeAppsDialog" parent="Theme.DisplayMediaTitles" />
</resources>