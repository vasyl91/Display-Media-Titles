<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifest overlay for the "standard" flavor (regular, non-system app; it was called "phone").

    It is merged on top of src/main/AndroidManifest.xml:
     - android:sharedUserId="android.uid.system" is removed, so the APK can be installed like any other
       app on phones, tablets and FYT units whose firmware is not signed with the platform key,
     - permissions that only the system UID / privileged apps can hold are dropped (none is left
       in src/main since the unused ones were removed there),
     - the runtime storage permissions are dropped as well: fonts are imported through the system
       file picker. MANAGE_EXTERNAL_STORAGE (all files access) stays declared but is never asked
       for: only "Use Shizuku / root" grants it (PrivilegedGrants), and with it the tags and
       covers of local music files (com.syu.music, com.syu.media) can be read.
    The overlay then uses TYPE_APPLICATION_OVERLAY (see Privileges.kt) and the user grants
    "notification access", "display over other apps" and the battery exemption.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:remove="android:sharedUserId">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application>
        <!-- Receives Shizuku's binder (vasyl.titles.privileged.ShizukuHost); only the system
             (INTERACT_ACROSS_USERS_FULL) may call it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
